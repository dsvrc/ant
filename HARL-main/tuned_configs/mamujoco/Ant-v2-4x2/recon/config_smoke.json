{
    "algo_args": {
        "algo": {
            "action_aggregation": "prod",
            "actor_num_mini_batch": 1,
            "clip_param": 0.1,
            "critic_epoch": 5,
            "critic_num_mini_batch": 1,
            "entropy_coef": 0,
            "fixed_order": false,
            "gae_lambda": 0.95,
            "gamma": 0.99,
            "huber_delta": 10.0,
            "max_grad_norm": 10.0,
            "ppo_epoch": 5,
            "share_param": false,
            "use_clipped_value_loss": true,
            "use_gae": true,
            "use_huber_loss": true,
            "use_max_grad_norm": true,
            "use_policy_active_masks": true,
            "value_loss_coef": 1,
            "recon": {
                "compensate": true,
                "beta_mode": "fixed",
                "beta_fixed": 1.0,
                "label_mode": "self_supervised",
                "auto_readout": true,
                "auto_lock_after": 5,
                "trough_baseline": true,
                "trough_floor_pct": 10.0,
                "trough_hist": 40,
                "filter": {
                    "arch": "gru",
                    "hidden": 64,
                    "adam_lr": 0.0003,
                    "epochs": 4,
                    "stack_len": 16,
                    "var_head": false,
                    "grad_clip": 10.0
                },
                "identifier": {
                    "mode": "clipfit",
                    "rho_grid": null,
                    "rho": 0.8,
                    "nuisance_instant": false,
                    "W": 2000,
                    "lock_min_gain": 0.01,
                    "grid_dc": 0.025,
                    "c_grid_max": 1.2,
                    "x2_margin": 25,
                    "c_clip": 1.5,
                    "smooth_windows": 2.0,
                    "use_ankle_channel": true,
                    "hip_action_idx": 0,
                    "ankle_action_idx": 1
                },
                "filter_oracle": false,
                "debug": true,
                "debug_every": 1,
                "scan_every": 5,
                "severity_diag": 0.45
            }
        },
        "device": {
            "cuda": true,
            "cuda_deterministic": true,
            "torch_threads": 4
        },
        "eval": {
            "eval_episodes": 40,
            "n_eval_rollout_threads": 20,
            "use_eval": true
        },
        "logger": {
            "log_dir": "./results"
        },
        "model": {
            "activation_func": "relu",
            "critic_lr": 0.0005,
            "data_chunk_length": 10,
            "gain": 0.01,
            "hidden_sizes": [
                128,
                128,
                128
            ],
            "initialization_method": "orthogonal_",
            "lr": 0.0005,
            "opti_eps": 1e-05,
            "recurrent_n": 1,
            "std_x_coef": 1,
            "std_y_coef": 0.5,
            "use_feature_normalization": true,
            "use_naive_recurrent_policy": false,
            "use_recurrent_policy": false,
            "weight_decay": 0
        },
        "render": {
            "render_episodes": 10,
            "use_render": false
        },
        "seed": {
            "seed": 1,
            "seed_specify": true
        },
        "train": {
            "episode_length": 200,
            "eval_interval": 15,
            "log_interval": 5,
            "model_dir": null,
            "n_rollout_threads": 20,
            "num_env_steps": 1200000,
            "use_linear_lr_decay": false,
            "use_valuenorm": true,
            "use_proper_time_limits": true
        }
    },
    "env_args": {
        "agent_conf": "4x2",
        "agent_obsk": 0,
        "episode_limit": 1000,
        "scenario": "Ant-v2",
        "recon": true,
        "recon_cfg": {
            "readout_qvel_idx": [17, 19, 21, 23],
            "readout_qvel_idx_ankle": [18, 20, 22, 24]
        },
        "pcr_eval_dephase": true,
        "pcr_period": 40000
    },
    "main_args": {
        "algo": "recon",
        "env": "mamujoco",
        "exp_name": "recon_smoke",
        "load_config": ""
    }
