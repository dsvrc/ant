{
    "algo_args": {
        "algo": {
            "alpha": 0.2,
            "alpha_lr": 0.0003,
            "auto_alpha": false,
            "batch_size": 1000,
            "buffer_size": 1000000,
            "fixed_order": false,
            "gamma": 0.99,
            "huber_delta": 10.0,
            "n_step": 5,
            "polyak": 0.005,
            "share_param": false,
            "use_huber_loss": false,
            "use_policy_active_masks": true
        },
        "device": {
            "cuda": true,
            "cuda_deterministic": true,
            "torch_threads": 4
        },
        "eval": {
            "eval_episodes": 40,
            "n_eval_rollout_threads": 20,
            "use_eval": true
        },
        "logger": {
            "log_dir": "./results"
        },
        "model": {
            "activation_func": "relu",
            "critic_lr": 0.0003,
            "final_activation_func": "tanh",
            "gain": 0.01,
            "hidden_sizes": [
                256,
                256
            ],
            "initialization_method": "orthogonal_",
            "lr": 0.001,
            "use_feature_normalization": true
        },
        "render": {
            "render_episodes": 10,
            "use_render": false
        },
        "seed": {
            "seed": 1,
            "seed_specify": true
        },
        "train": {
            "eval_interval": 10000,
            "log_interval": null,
            "model_dir": null,
            "n_rollout_threads": 20,
            "num_env_steps": 10000000,
            "train_interval": 50,
            "update_per_train": 1,
            "use_linear_lr_decay": false,
            "use_proper_time_limits": true,
            "use_valuenorm": false,
            "warmup_steps": 10000
        }
    },
    "env_args": {
        "agent_conf": "4x2",
        "agent_obsk": 0,
        "episode_limit": 1000,
        "scenario": "Ant-v2",
        "echor": true,
        "echor_cfg": {
            "eps": 0.03,
            "T_chip": 3,
            "L": 127,
            "delta_shift": 16,
            "K": 15,
            "lam_halflife": 2000,
            "rho_hat": 0.8,
            "W_anchor": 100000,
            "anchor_subsample": 100,
            "anchor_q": 0.05,
            "g_min_frac": 0.1,
            "c_clip": 10.0,
            "center_halflife": 200,
            "readout_qvel_idx": [19, 21, 23, 25],
            "snr_gate": 1.0,
            "c_oracle": false,
            "debug": true,
            "debug_dir": "./echor_debug",
            "debug_interval": 20
        }
    },
    "main_args": {
        "algo": "echor_hasac",
        "env": "mamujoco",
        "exp_name": "report",
        "load_config": ""
    }
}
